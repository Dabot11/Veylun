{
  "name": "veylun",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Veylun: El Santuario Olvidado — MVP jugable de aventura 3D",
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "node scripts/deploy-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
